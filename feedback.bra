          .   !arg:(?arg.?k)
            & @(!arg:? [?l)
            &   whl
              ' (1+!l:~>!k:?l&" " !arg:?arg)
            & str$!arg
        )
      & "D: divisor to scale down bars, so they fit in a text window that is also readable
                 M: padding to the left of length to right-align length field
                 N: padding to the left of count to right-align count field
                "
      & !arg:(?arg.?name.?D.?M.?N)
      & 5:?maxblank
      & 0:?next
      &   put
        $ (   str
            $ ( mop
              $ ( ( 
                  =   
                    .   !arg:#?n*(.?m)
                      & !m+-1*!next:?blanklines
                      & :?blank
                      & (   !blanklines:~>!maxblank
                          & !m:?next
                          &   whl
                            ' ( !blanklines+-1:~<0:?blanklines
                              &     num$(-1+!next:?next.!M)
                                    \t
                                    num$(0.!N)
                                    \t\n
                                    !blank
                                : ?blank
                              )
                        |   num$(str$("[x" !blanklines "]").!M) \t num$(0.!N) \t\n
                          : ?blank
                        )
                      & 1+!m:?next
                      & !blank num$(!m.!M) \t num$(!n.!N) \t stars$(div$(!n,!D))
                  )
                . !arg
                . (=+)
                . (=a b)
                )
              )
          , str$(!(its.root) !name ".txt")
          , BIN
          , NEW
          )
  )
  ( doit
  =     r feedback
      , "---" PROD Persons colouredTurns html interruption-by monologue short-remarks
      , speakover textgrids turn-giving turns wordstat wordstatNR wordstatWght wordstatWghtNR
      , worddurations
    .   ~
      |   speakover:?speakover
        & interruption:?interruption-by
        & turn-giving:?turn-giving
        & short-remarks:?short-remarks
        & monologue:?monologue
        &   !arg
          : ( ?Sep
            . ?(its.root)
            . ?(its.inputroot)
            . ?(its.sessionID)
            . ?(its.speech)
            . ?(its.agreedFeedbackWords)
            )
        & (its.dir)$:?textgrids
        & (     map
              $ ( ( 
                  =   
                    .     out$(arg !arg)
                        & @(!arg:? long ?)
                        & !arg
                      | 
                  )
                . !textgrids
                )
            : ~
            : ?textgrids
          | 
          )
        & !textgrids:~
        & 0:?Persons
        & 0:?FeedbackLatencies:?FeedbackLatenciesStrict
        & :?feedbackLenghts
        & "The following loop creates an HTML file for each meeting. These files are stored in praat/html"
        & map$((=.(its.readTextGrid)$!arg).!textgrids):?htmlpath/turns
        & (|lst$(htmlpath/turns,htmlpath-turns,NEW))
        &     map
            $ ( (=.!arg:(?arg.?)&!arg)
              . !htmlpath/turns
              )
          : ?htmlpaths
        &     map
            $ ( (=.!arg:(?.?arg)&!arg)
              . !htmlpath/turns
              )
          : ?turns
        & (|lst$(feedbackLenghts,feedbackLenghts,NEW,RAW,WYD))
        &     mop
            $ ( (=.!arg:(?l.?w)&(!l.low$!w))
              . !feedbackLenghts
              . (=a a)
              . (=+)
              )
          : ?feedbackLenghtsSorted
        & ( 
          | lst$(feedbackLenghtsSorted,feedbackLenghtsSorted,NEW,RAW,WYD)
          )
        & (its.FeedBackLengths)$(!feedbackLenghtsSorted.1):?feedbackLenghtsSortedNoWords1
        & ( 
          | lst$(feedbackLenghtsSortedNoWords1,feedbackLenghtsSortedNoWords1,NEW,RAW,WYD)
          )
        & (its.FeedBackLengths)$(!feedbackLenghtsSorted.2):?feedbackLenghtsSortedNoWords2
        & ( 
          | lst$(feedbackLenghtsSortedNoWords2,feedbackLenghtsSortedNoWords2,NEW,RAW,WYD)
          )
        & (|lst$(FeedbackLatencies,FeedbackLatencies,NEW,RAW,WYD))
        & ( 
          | lst$(FeedbackLatenciesStrict,FeedbackLatenciesStrict,NEW,RAW,WYD)
          )
        & feedbackLenghtsSortedNoWords1
        & (its.hist)$(!feedbackLenghtsSortedNoWords1.feedbackLenghtsSortedNoWords1.5.4.4)
        & (its.hist)$(!feedbackLenghtsSortedNoWords2.feedbackLenghtsSortedNoWords2.5.4.4)
        & (its.hist)$(!FeedbackLatencies.FeedbackLatencies.10.3.4)
        & (its.hist)$(!FeedbackLatenciesStrict.FeedbackLatenciesStrict.10.3.4)
        & (|lst$(turns,"turns.bra",NEW,RAW,WYD))
        & (|lst$(Persons,Persons,NEW,RAW,WYD))
        & (its.CreatePersonWords)$!Persons
        & (its.wordDurations)$!turns:?worddurations
        & (|lst$(worddurations,worddurations,NEW,RAW,WYD,BIN))
        & (its.getFeedbackWordStats)$!turns:?"---"
        & (|lst$("---",feedbackwords,NEW,WYD))
        & (its.getWordStats)$!turns:?wordstat
        & (|lst$(wordstat,wordstat0,NEW,WYD,RAW))
        & (its.getWordStatsWght)$!turns:?wordstatWght
        & (its.weightSort)$!wordstat:?wordstat
        & (its.weightSort)$!wordstatWght:?wordstatWght
        & (|lst$(wordstatWght,wordstatWght,NEW,WYD,RAW))
        & (|lst$(wordstat,wordstat,NEW,WYD,RAW))
        & (its.number)$!wordstat:?wordstatNR
        & (its.number)$!wordstatWght:?wordstatWghtNR
        & (|lst$(wordstatNR,wordstatNR,NEW,WYD,RAW))
        & (|lst$(wordstatWghtNR,wordstatWghtNR,NEW,WYD,RAW))
        & (its.multiply)$(!wordstatWghtNR.!wordstatNR):?PROD
        & (|lst$(PROD,wordPROD,NEW,WYD,RAW))
        & (its.countDurations)$(!turns.!PROD.!wordstatNR):?colouredTurns
        & (|lst$(colouredTurns,colouredTurns,NEW,WYD,RAW))
        & (its.sanitizeColourTags)$!colouredTurns:?colouredTurns
        & (|lst$(colouredTurns,colouredTurnsSanitized,NEW,WYD,RAW))
        & (its.feedbackIntervals)$!colouredTurns:?intervals
        & (its.tabify)$!intervals:?tabintervals
        & (|lst$(tabintervals,"intervals.tab",NEW,BIN))
        & (|lst$(intervals,intervals,NEW,RAW,WYD))
        & (its.HTML)$!colouredTurns:?html
        & (|lst$(html,"all.bra",NEW,WYD,RAW))
        & nestML$!html:?html
        & (|lst$(html,"allNest.bra",NEW,WYD,RAW))
        &   put
          $ ( toML$(html.,(body.,!html))
            , str$(!(its.root) "allGEHM.html")
            , NEW
            , BIN
            )
        &     mop
            $ ( ( 
                =   
                  .   !arg:?n*(?l.?)
                    & ( !l:<200&(,!l !n)
                      | 
                      )
                )
              . !feedbackLenghtsSorted
              . (=+)
              . (=a b)
              )
          : ?lens
        & (|lst$(lens,lens,NEW,RAW,WYD))
        & (its.sd)$!lens:(?stddev.?avg)
        & out$(stddev !stddev avg !avg)
        & !htmlpaths
  )
  (new=r feedback.);

r=
  get'("feedback.bra",TXT)
& rmv$(str$(feedback ".bak"))
& ren$("feedback.bra".str$(feedback ".bak"))
&   put
  $ ( "{feedback.bra
𝕌𝕋𝔽-𝟠

Progress:
(1) TextGrid data only:
* Finding the lengths of uninterrupted speech.
* Create HTML table with colour coding for speakers.
* The shorter the lenght of uninterrupted speach, the further to the right. 
* Each line contains one word: start time, end time and difference between start of current word
  and end of previous word. Time unit: centiseconds (seconds if using fixed point notation).
(2) Compile some statistics to show, for each Zoom recording, how many times we see short
    interruptions (between 1 and 5 words) involving words such 
         yeah, okay, yes, no, ok, sure
    (with or without capitalisation).

    As a first step, I have created a ordered word list that puts all declared feedback words among
    the first 23 words in the list of a total of 3456 words. It is as follows:
    (a)  Create two word lists
           (1) a list with pairs (word, word frequency). Here, the word frequency is computed by
               counting word occurrences in all zoom meetings.
           (2) a similar list, but each occurrence of a word weighed by length of the unbroken
               utterance it is part of. So if two people are talking at the same time, utterances
               get broken up in short word sequences. The lengths of these short sequences constitute
               the weighing factor, or rather, the inverse of the length. So the shorter the sequence
               the higher the weight.
    (b)  Sort the two lists according to the (weighed or not) frequencies, so the most prominent words
         are near the top of the list.
    (c)  Replace the (weighed or not) frequencies by cardinal numbers, starting from 1. Words with the
         same (weighed or not) frequency get the same number. Otherwise, numbers are incremented by 1.
    (d)  Sort the two lists alphabetically. The lists list all words in the same order.
    (e)  Iterate over all words, creating a new list where the number from the weighted list is divided
         by the number from the unweighted list. The more frequent a word is, the further down the list
         it will be pushed, while the more prominent the word is in short unbroken utterances, the higher
         up the list it will be pushed.

    The first 'word' in the list is the empty string. Probably Whisper did hear a sound but could not
    make out what it was. 
    Here are the first 55 words:

      yeah      thank     nice      youre     problem   my
      okay      exactly   sure      but       abstracts change
      yes       thanks    lets      remember  marianne  pilar
      hmm       mhm       great     very      always    i
      oh        mm        see       im        indeed    so
      no        thats     patrizia  perhaps   send
      bye       fine      theres    think     hello
      right     sorry     its       important course
      ok        good      everybody soon      will
      well      wow       all       still     many
                                              
    
    The contrast with the unweighted list is stark:

      the       of        think     can       what      there   
      i         know      its       then      at        they
      to        it        this      okay      also      will
      that      but       dont      would     with      well
      and       in        mean      on        just      people
      we        have      yes       about     very
      you       is        because   was       or
      so        right     not       do        im
      yeah      be        thats     are       one
      a         for       if        like      really

    Of the latter list, 41 words are not present in the first list:

      the       in        if        what      people
      to        have      can       at
      that      is        then      also
      and       be        would     with
      we        for       on        just
      you       this      about     or
      a         dont      was       one
      of        mean      do        really
      know      because   are       there
      it        not       like      they
}

"
    , "feedback.bra"
    , NEW
    , BIN
    )
& lst'(feedback,"feedback.bra",APP,BIN,WYD)
& put'(\n,"feedback.bra",APP,BIN)
& lst'(r,"feedback.bra",APP,BIN,WYD)
& put$(str$("\nnew'" feedback ";\n"),"feedback.bra",APP,BIN)
& OK;

new'feedback;
