{doall.bra
𝕌𝕋𝔽-𝟠

Call feedback.bra to create html formatted output from TextGrid data (From the FinalDataset folder)
Call speakseries.bra to create tabulated output from the html formatted dialogue data
Call OpenPose2VAJ.bra to create velocity/acceleration/jerk data from OpenPose data.
Call movieanno (binary executable) to add an VAJ and TextGriddata overlay to movies in FinalDataset. Audio gets lost in the process.
Call addaudio.sh to (a) move flags in the output movie, so videoplayers don't complain (b) add audio (found in FinalDataset in separate audio files.}

doall=
  "
  This is an example value of 'root'. Value is overwritten, and depends also on OS. See 'new' function.
  "
  (root="/home/bart/Gehm-movieanno/")
  "
  Modify inputroot, sessionID, keypoints, SeparatedSpeakersVideo to match folder structure of input.
  "
  (inputroot=FinalDataset)
  (sessionID=20210504)
  (keypoints=OpenPoseKeypoints)
  (OriginalVideo=OriginalVideo)
  (SeparatedSpeakersVideo=SeparatedSpeakersVideo)
  "
  Modify tab, speech, derivatives, outputroot to match the names of subfolders containing intermediary results and output.
   Each subfolder will be created directly in the root folder.
  "
  (tab=keypoints)
  (speech=praat)
  (derivatives=vaj)
  (outputroot=overlay)
  "
  Modify windowSizes as wanted.
   The first number is the number of movie frames used to estimate velocity, 
   the second to estimate acceleration and the third to estimate jerk.
  "
  (windowSizes=9 9 9)
  "
  The list of feedbackWords can be modified.
  "
  ( feedbackWords
  = yeah nice okay sure yes hmm mhm great oh mm no fine right ok good
  )
  ( mkdir
  =   
    .   sys
      $ ( str
        $ ( "mkdir "
            (!OS:Windows&|"-p ")
            !arg
            ( !OS:Windows&" >nul 2>&1"
            | " >/dev/null 2>&1"
            )
          )
        )
  )
  ( doit
  =   zoompaths
    .   ~
      |   get$"feedback.bra"
        & "
           From TextGrid data, produce output that shows the structure of the dialogue
           in terms of the number of words a participant can speak before another takes over.
           The shorter the sequences, the further to the right the words are positioned, columnwise.
           In that way, short interruptions are visually easily detected.
           Speakers are colour coded.
           Words have time stamps and duration.
           Output is HTML formatted.
          "
        & out$"Calling feedback"
        &     (feedback.doit)
            $ ( !sep
              . !(its.root)
              . !(its.inputroot)
              . !(its.sessionID)
              . !(its.speech)
              . !(its.feedbackWords)
              )
          : ?zoompaths
        & get$"speakseries.bra"
        & "
           Read yyyymmdd_Praat_long.TextGrid.html and output 'speaker \\t feedback y/n \\t start \\t end \\t word \\n'
          "
        &   map
          $ ( ( 
              = .out$"Calling speakseries"&(speakseries.doit)$(!sep.!arg)
              )
            . !zoompaths
            )
        & "
           Read all OpenPose json files for a session and create, for each participant, a single tab-separated file for pose_keypoints_2d
          "
        & get$"OpenPose2VAJ.bra"
        & out$"Calling OpenPose2VAJ"
        &   (OpenPose2VAJ.doit)
          $ ( !(its.root)
            . !(its.inputroot)
            . !(its.tab)
            . !(its.derivatives)
            . !(its.sessionID)
            . !(its.keypoints)
            . !(its.windowSizes)
            )
        &   map$((=."-" !arg).!(its.windowSizes))
          : "-" ?hyphenatedwindowSizes
        &     str
            $ ( (!OS:Windows&|src/movieanno/)
                movieanno
                " -a"
                !(its.speech)
                " -d"
                !(its.root)
                " -f"
                !hyphenatedwindowSizes
                " -i"
                !(its.OriginalVideo)
                " -j"
                !(its.SeparatedSpeakersVideo)
                " -k"
                !(its.derivatives)
                " -m"
                !(its.inputroot)
                " -o"
                !(its.outputroot)
                " -s"
                !(its.sessionID)
                " -t"
                !(its.keypoints)
              )
          : ?command
        & out$("command: " !command)
        & out$"Calling movieanno"
        & sys$!command
        &   (   !OS:Windows
              &   str
                $ ( "dir /B "
                    !(its.root)
                    !(its.inputroot)
                    !sep
                    !(its.sessionID)
                    !sep
                    !(its.SeparatedSpeakersVideo)
                    " >speakers 2>nul"
                  )
            |   str
              $ ( "ls -d -1 "
                  !(its.root)
                  !(its.inputroot)
                  !sep
                  !(its.sessionID)
                  !sep
                  !(its.SeparatedSpeakersVideo)
                  !sep
                  "* | xargs -n 1 basename >TextGrids 2>/dev/null >speakers 2>/dev/null"
                )
            )
          : ?dircom
        & out$(dircom !dircom)
        & sys$!dircom
        & get$(speakers,STR):?speakers
        &     vap
            $ ( ( 
                =   
                  .   ( @(!arg:!(its.sessionID) "-" ?arg "." ?)
                      | 
                      )
                    & !arg
                )
              . !speakers
              . \n
              )
          : ?speakers
        & out$(speakers !speakers)
        &   map
          $ ( ( 
              =   Com
                .   str$(!command " -p" !arg):?Com
                  & out$("command: " !Com)
                  & out$"Calling movieanno"
                  & sys$!Com
              )
            . !speakers
            )
        &     str
            $ ( (!OS:Windows&|src/addaudio/)
                addaudio
                " "
                !(its.root)
                !(its.inputroot)
                " "
                !(its.root)
                !(its.outputroot)
              )
          : ?command
        & out$!command
        & out$"Calling addaudio"
        & sys$!command
      | 
  )
  "By declaring doall local in 'new', global doall is not only protected. Its members cannot be called from other objects that are accessed from 'new' or nested calls. "
  ( new
  =   doall
    .   ~
      |     ( @(!v:? Windows ?)&("\\".Windows.".\\")
            | ("/".Unix."/home/bart/Gehm-movieanno/")
            )
          : (?sep.?OS.?(its.root))
        & '$r:(=?save-r)
        & ((its.doit)$|)
        & '$save-r:(=?r)
  );

r=
  get'("doall.bra",TXT)
& rmv$(str$(doall ".bak"))
& ren$("doall.bra".str$(doall ".bak"))
&   put
  $ ( "{doall.bra
𝕌𝕋𝔽-𝟠

Call feedback.bra to create html formatted output from TextGrid data (From the FinalDataset folder)
Call speakseries.bra to create tabulated output from the html formatted dialogue data
Call OpenPose2VAJ.bra to create velocity/acceleration/jerk data from OpenPose data.
Call movieanno (binary executable) to add an VAJ and TextGriddata overlay to movies in FinalDataset. Audio gets lost in the process.
Call addaudio.sh to (a) move flags in the output movie, so videoplayers don't complain (b) add audio (found in FinalDataset in separate audio files.}

"
    , "doall.bra"
    , NEW
    , BIN
    )
& lst'(doall,"doall.bra",APP,BIN,WYD)
& put'(\n,"doall.bra",APP,BIN)
& lst'(r,"doall.bra",APP,BIN,WYD)
& put$(str$("\nnew'" doall ";\n"),"doall.bra",APP,BIN)
& ;

new'doall;
